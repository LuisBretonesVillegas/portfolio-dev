---
import Portfolio from '../layouts/Portfolio.astro';

const pdf = '/luis-bretones-cv.pdf';
---
<Portfolio title="CV | Luis Bretones" description="CV of Luis Bretones, Computer Engineering student building toward DevOps and SRE.">
  <div class="cv-header">
    <h2>CV</h2>
    <p>My experience, projects, and skills on one page.</p>
    <div class="cv-actions">
      <a href={pdf} download="Luis-Bretones-CV.pdf" class="cv-btn cv-btn-primary">Download PDF ↓</a>
      <a href={pdf} target="_blank" rel="noopener" class="cv-btn">Open in a new tab →</a>
    </div>
  </div>

  <div class="cv-preview">
    <iframe src={`${pdf}#pagemode=none&view=FitH&toolbar=0`} title="Luis Bretones CV"></iframe>
  </div>
</Portfolio>

<style>
  .cv-header { padding: 4rem 0 2rem; }
  .cv-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.5rem;
    line-height: 1.15;
  }
  .cv-header p {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .cv-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .cv-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.55rem 1.1rem;
    border-radius: 3px;
    text-decoration: none;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
  .cv-btn:hover { background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .cv-btn-primary { background: var(--accent); color: #fff; }
  .cv-btn-primary:hover { background: #0f3a00; border-color: #0f3a00; }
  .cv-preview { padding-bottom: 3rem; }
  .cv-preview iframe {
    display: block;
    width: 100%;
    height: 1120px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: #fff;
  }

  /* Phone browsers don't render PDFs inline reliably; the buttons cover it. */
  @media (max-width: 768px) {
    .cv-header { padding: 2.5rem 0 3rem; }
    .cv-preview { display: none; }
  }
</style>
